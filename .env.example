# ============================================================
# Unknown Sender — environment variables
# Copy this file to `.env` and fill in the values for local dev.
# On Cloudflare Pages, set the same vars in the dashboard under
# Settings > Environment variables. Never commit real secrets.
# ============================================================

# --- Supabase (PUBLIC_ = exposed to browser, protected by RLS) ---
PUBLIC_SUPABASE_URL=https://jzhscfljvmrxfypgadel.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, bypasses RLS — NEVER expose) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server-only) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Set true once the live Stripe account is verified and we're using live keys
STRIPE_LIVE_MODE=false

# --- Game app backend ---
# Base URL for the app's public READ endpoints (games + leaderboard).
# See API_CONTRACT.md at repo root for the exact endpoint shapes.
# Site will call: GET {APP_BACKEND_URL}/games/{slug}
#                 GET {APP_BACKEND_URL}/leaderboard/{slug}?limit=25
APP_BACKEND_URL=https://api.unknownsender.co.uk

# The endpoint the site POSTs to when a booking is created (server-only).
APP_BACKEND_BOOKING_URL=https://api.unknownsender.co.uk/bookings
# Shared secret used to sign the webhook payload (HMAC-SHA256).
APP_BACKEND_WEBHOOK_SECRET=

# --- Brevo transactional emails (server-only) ---
BREVO_API_KEY=

# --- Brevo waitlist form (public — client-side POST) ---
# The form action URL from a Brevo subscription form's "Share" page.
# Used when a game's bookingsOpenAt is still in the future, so users
# can join a waitlist instead of booking. Safe to expose to the browser
# (Brevo intends these URLs to be public).
PUBLIC_BREVO_WAITLIST_URL=

# --- Site ---
# Absolute URL of the deployed site; used in Stripe redirect URLs, etc.
PUBLIC_SITE_URL=https://unknownsender.co.uk
