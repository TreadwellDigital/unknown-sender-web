# ============================================================
# Unknown Sender — environment variables
# Copy this file to `.env` and fill in the values for local dev.
# On Cloudflare Pages, set the same vars in the dashboard under
# Settings > Variables and secrets (Build + Runtime for PUBLIC_*
# ones, Runtime only for secrets). Never commit real secrets.
# ============================================================

# --- Game app backend (public reads: games catalogue, leaderboard) ---
# Site fetches from {APP_BACKEND_URL}/api/games and /api/leaderboard,
# and proxies purchases via {APP_BACKEND_URL}/web-api/games/purchase-guest.
APP_BACKEND_URL=https://api.unknownsender.co.uk

# --- Stripe (PUBLIC — publishable key, safe to expose to the browser) ---
# Where: dashboard.stripe.com → Developers → API keys.
# Used by Stripe.js on the site to render the inline card form. The
# secret key lives on the game app backend (Jonathan's server), not here.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Brevo waitlist form (public — client-side POST) ---
# The form action URL from a Brevo subscription form's HTML snippet.
# Used when a game's bookingsOpenAt is still in the future.
PUBLIC_BREVO_WAITLIST_URL=

# --- Site ---
# Absolute URL of the deployed site (used in canonical URLs etc.)
PUBLIC_SITE_URL=https://unknownsender.co.uk
