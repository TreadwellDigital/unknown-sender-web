---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';

// Review destinations. Set these once and forget.
// - TripAdvisor: full "Write a review" URL from the property page.
// - Google:     the "Leave a review" URL from your Google Business Profile
//   (Profile → Read reviews → Get more reviews → copy short link).
//   Set to null to hide the Google card until verification's finished.
const tripAdvisorUrl = 'https://www.tripadvisor.co.uk/UserReviewEdit-g186411-d34687462-Unknown_Sender-Leeds_West_Yorkshire_England.html';
const googleUrl: string | null = null; // TODO: paste when Google Business verified
---

<BaseLayout
  title="Leave a review, Unknown Sender"
  description="Enjoyed the game? Leave a review on Google or TripAdvisor — it helps other players find us."
  canonicalPath="/reviews"
>
  <article class="page">
    <div class="wrap-narrow">
      <div class="eyebrow"><span class="dot"></span>Reviews</div>
      <h1>Thanks for playing.</h1>
      <p class="lede">
        If you enjoyed the game, a review means a lot — reviews are how new players
        find us. Pick whichever you use most.
      </p>

      <div class="review-grid">
        {googleUrl && (
          <a href={googleUrl} class="review-card" target="_blank" rel="noopener noreferrer">
            <div class="review-logo" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="28" height="28">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
            </div>
            <div class="review-body">
              <div class="review-label">Review on</div>
              <div class="review-name">Google</div>
            </div>
            <div class="review-arrow" aria-hidden="true">&rarr;</div>
          </a>
        )}

        <a href={tripAdvisorUrl} class="review-card" target="_blank" rel="noopener noreferrer">
          <div class="review-logo" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28">
              <circle cx="12" cy="12" r="11" fill="#00AA6C"/>
              <circle cx="7.5" cy="12" r="2.4" fill="#000"/>
              <circle cx="7.5" cy="12" r="1" fill="#fff"/>
              <circle cx="16.5" cy="12" r="2.4" fill="#000"/>
              <circle cx="16.5" cy="12" r="1" fill="#fff"/>
            </svg>
          </div>
          <div class="review-body">
            <div class="review-label">Review on</div>
            <div class="review-name">TripAdvisor</div>
          </div>
          <div class="review-arrow" aria-hidden="true">&rarr;</div>
        </a>
      </div>

      {!googleUrl && (
        <p class="fine">
          Google reviews coming soon — we&rsquo;re just waiting on verification.
        </p>
      )}

      <p class="closing">
        Not enjoyed something? Please tell us first — <a href="https://wa.me/447428005847"><strong>WhatsApp us</strong></a>
        or email <a href="mailto:hello@unknownsender.co.uk">hello@unknownsender.co.uk</a>.
        We&rsquo;ll always try to make it right.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .page { padding: 80px 0; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.5rem); margin: 20px 0 20px; letter-spacing: -0.03em; }
  .lede {
    color: var(--ink-dim);
    font-size: 17px;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 560px;
  }

  .review-grid {
    display: grid;
    gap: 16px;
    margin-bottom: 24px;
  }

  .review-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    background: var(--panel);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .review-card:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    background: rgba(255,255,255,0.02);
  }

  .review-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: #fff;
    border-radius: 10px;
  }

  .review-body { flex: 1; }
  .review-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--ink-dim);
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .review-name {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .review-arrow {
    font-size: 20px;
    color: var(--ink-dim);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .review-card:hover .review-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  .fine {
    margin: 0 0 24px;
    font-size: 13px;
    color: var(--ink-dim);
    font-style: italic;
  }

  .closing {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-size: 14px;
    line-height: 1.6;
  }
  .closing a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .closing a:hover { color: var(--accent); }
</style>
