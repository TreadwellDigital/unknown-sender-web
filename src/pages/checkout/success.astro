---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Booking confirmed, Unknown Sender"
  description="Your booking is confirmed."
  canonicalPath="/checkout/success"
>
  <section class="page">
    <div class="wrap-narrow">
      <div class="eyebrow"><span class="dot"></span>Confirmed</div>
      <h1>Message received.</h1>
      <p class="lede">
        Your payment has gone through. Check your inbox in the next couple of minutes
        for an email with a link to open the game inside the <strong>Unknown Sender</strong> app.
      </p>

      <div class="code-box">
        <div class="code-label">Next step</div>
        <div class="code">Check your email</div>
        <p class="code-note">
          Didn&rsquo;t arrive? Check your spam folder, or open the app and tap
          &ldquo;Sign in with email&rdquo; to get a fresh link.
        </p>
      </div>

      <div class="next">
        <div class="eyebrow">Before you play</div>
        <ul>
          <li>Install the <strong>Unknown Sender</strong> app from the App Store or Google Play.</li>
          <li>Skim the <a href="/player-manual">player manual</a>, it&rsquo;s a two-minute read.</li>
          <li>Read the <a href="/before-you-play">safety brief</a> for kit and weather.</li>
          <li>Head to the start location in the app when you&rsquo;re ready to play.</li>
        </ul>
        <p class="actions">
          <a class="btn btn-ghost" href="/player-manual">Read the manual</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 100px 0; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.5rem); margin: 20px 0 16px; letter-spacing: -0.03em; }
  .lede { color: var(--ink-dim); font-size: 17px; line-height: 1.6; margin-bottom: 48px; max-width: 560px; }
  .lede strong { color: var(--ink); }

  .code-box {
    padding: 32px;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--panel);
    text-align: center;
    margin-bottom: 48px;
  }
  .code-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--ink-dim);
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 24px;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 500;
  }
  .code-note {
    margin-top: 16px;
    font-size: 13px;
    color: var(--ink-dim);
    line-height: 1.5;
  }

  .next .eyebrow { margin-bottom: 20px; }
  .next ul {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-bottom: 24px;
  }
  .next li {
    padding-left: 20px;
    position: relative;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }
  .next li strong { color: var(--ink); }
  .next li::before {
    content: '';
    position: absolute;
    left: 0; top: 12px;
    width: 6px; height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }
  .next a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .actions { margin-top: 24px; }
</style>
