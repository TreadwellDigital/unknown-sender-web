---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Booking cancelled — Unknown Sender"
  description="Your booking was cancelled."
  canonicalPath="/checkout/cancelled"
>
  <section class="page">
    <div class="wrap-narrow">
      <div class="eyebrow">Cancelled</div>
      <h1>Not this time.</h1>
      <p class="lede">
        The booking wasn&rsquo;t completed. Nothing has been charged. You can
        head back and try again whenever you&rsquo;re ready.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/games">See games</a>
        <a class="btn btn-ghost" href="/">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page { padding: 100px 0; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.5rem); margin: 20px 0 16px; }
  .lede { color: var(--ink-dim); font-size: 17px; line-height: 1.6; margin-bottom: 32px; max-width: 480px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
