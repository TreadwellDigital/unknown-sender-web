---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { formatPricePence, fetchGamesCatalogue, slugify } from '@/lib/pricing';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => data.status === 'live');
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const city = await getEntry('cities', game.data.citySlug);

// Overlay live app data on top of Markdown-owned fields.
const catalogue = await fetchGamesCatalogue();
const apiGame = catalogue.find(
  (g) => g.siteId === game.slug || slugify(g.name) === game.slug
);

const displayTitle       = apiGame?.name ?? game.data.title;
const displayDescription = apiGame?.description ?? game.data.summary;
const whatToExpect       = apiGame?.whatToExpectPoints ?? [];
const displayCity        = apiGame?.location ?? city?.data.name ?? game.data.citySlug;

// Booking window
const now = new Date();
const bookingsOpen = !game.data.bookingsOpenAt
  || now >= new Date(game.data.bookingsOpenAt);
const openDateFormatted = game.data.bookingsOpenAt
  ? new Date(game.data.bookingsOpenAt).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
    })
  : null;
// Brevo subscription-form action URL. Intentionally public — it's the
// same URL that would be in the form's shareable HTML snippet, so there's
// no secret to leak. The env var wins if set (useful for staging/dev
// pointing at a different form), but we ship a production default so the
// waitlist works even if the env var goes missing on the host.
const waitlistUrl =
  import.meta.env.PUBLIC_BREVO_WAITLIST_URL ||
  'https://aef6aabe.sibforms.com/serve/MUIFAEicZke5JZKVcRGwng2WuO5A9eg8MW4BviYPnH4Wpun9qnR-XSlLLrSiAFp7vqfmacZuLrPkO3UZFxzbh-34gGhpU1lEPqtGcudq-rw7XcZ53hd_s4w4SENvGkIBxKwRzKoK6SSHEj9mMjVUYHPOrXBL-trAnGQ1XNjmuzwqDjxLaYkZf-jnRntfxiKeC7RupGTqQM5m2ENRKg==';

// Leaderboard: pass the app's UUID for this game to the client script.
const appGameId = apiGame?.id ?? null;
const appBaseUrl = import.meta.env.APP_BACKEND_URL ?? '';

// Stripe publishable key — safe to expose to the browser (Stripe.js loads
// this to render the inline card form). The secret key lives on the game
// app backend, not here.
const stripePublishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY ?? '';

// Booking tiers. We prefer live data from the app (has stable UUIDs the
// backend expects at checkout) and fall back to the Markdown tiers only
// for display when the app is unreachable — those don't have valid UUIDs
// so the Book button gets disabled with an explanatory note.
type BookingTier = {
  id: string;         // app UUID (or empty when falling back to markdown)
  label: string;
  maxPlayers: number;
  pricePence: number;
};
const bookingTiers: BookingTier[] = apiGame?.tiers?.length
  ? apiGame.tiers.map((t) => ({
      id: t.id,
      label: t.label,
      maxPlayers: t.maxPlayers,
      pricePence: Math.round(t.price * 100), // API price is pounds, we show pence
    }))
  : game.data.priceTiers.map((t) => ({
      id: '', // no valid app UUID — Book button will be disabled
      label: t.label,
      maxPlayers: t.maxPlayers,
      pricePence: t.pricePence,
    }));
const tiersHaveIds = bookingTiers.every((t) => t.id.length > 0);
---

<BaseLayout
  title={`${displayTitle}, Unknown Sender`}
  description={game.data.tagline}
  canonicalPath={`/games/${game.slug}`}
  ogImage={game.data.heroImageDesktop}
  bodyClass="hero-page"
>
  <article>
    <section class="hero">
      <picture>
        <source media="(min-width: 768px)" srcset={game.data.heroImageDesktop} />
        <img src={game.data.heroImageMobile} alt={game.data.heroImageAlt} />
      </picture>

      <!-- Top bar: brand mark (left) + nav (right) wrapped in .wrap so both
           align with the same centered box as the heading below. -->
      <div class="hero-topbar">
        <div class="wrap hero-topbar-inner">
          <a href="/" class="hero-logo" aria-label="Unknown Sender home">
            <img
              src="/logo-640.png"
              srcset="/logo-640.png 1x, /logo-trimmed.png 2x"
              alt="Unknown Sender"
              width="220"
              height="107"
            />
          </a>
          <nav class="hero-nav" aria-label="Primary">
            <a href="/games">Case files</a>
            <a href="/player-manual">How to play</a>
            <a href="/before-you-play">Before you play</a>
          </nav>
        </div>
      </div>

      <div class="hero-overlay">
        <div class="wrap">
          <div class="eyebrow"><span class="dot"></span>{displayCity}</div>
          <h1>{displayTitle}</h1>
          <p class="tagline">{game.data.tagline}</p>
          <div class="hero-cta">
            <a href="#book" class="btn btn-primary">
              {bookingsOpen ? `Book ${displayTitle}` : 'Join waitlist'} &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="meta">
      <div class="wrap">
        <dl>
          <div><dt>Duration</dt><dd>{game.data.duration}</dd></div>
          <div><dt>Team size</dt><dd>Up to {Math.max(...game.data.priceTiers.map((t) => t.maxPlayers))}</dd></div>
          <div><dt>Age</dt><dd>{game.data.ageMin}+</dd></div>
          <div><dt>Valid for</dt><dd>{game.data.validityDays} days from purchase</dd></div>
        </dl>
      </div>
    </section>

    <section class="body wrap-narrow">
      <div class="eyebrow">Mission briefing</div>
      <p class="briefing">{displayDescription}</p>
    </section>

    {whatToExpect.length > 0 && (
      <section class="expect wrap-narrow">
        <div class="eyebrow">What to expect</div>
        <ul>
          {whatToExpect.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    )}

    {bookingsOpen ? (
      <section class="booking wrap-narrow" id="book">
        <div class="eyebrow">Book</div>
        <h2>Choose your team size</h2>

        <div class="tiers" data-game-slug={game.slug} data-game-id={appGameId ?? ''}>
          {bookingTiers.map((tier) => (
            <label class="tier">
              <input type="radio" name="tier" value={tier.id} data-price-pence={tier.pricePence} />
              <div class="tier-label">
                <div>
                  <div class="tier-name">{tier.label}</div>
                  <div class="tier-note">Up to {tier.maxPlayers} players</div>
                </div>
                <div class="tier-price">{formatPricePence(tier.pricePence)}</div>
              </div>
            </label>
          ))}
        </div>

        <label class="field">
          <span>Team name</span>
          <input type="text" name="teamName" id="teamName" maxlength="50" placeholder="e.g. The Suspects" />
        </label>

        <label class="field">
          <span>Your name</span>
          <input type="text" name="displayName" id="displayName" maxlength="50" placeholder="Shown in-game" />
        </label>

        <label class="field">
          <span>Your email</span>
          <input type="email" name="email" id="email" placeholder="you@example.com" />
        </label>

        {/* Stripe Elements (inline card form) mounts here once the user
            clicks Continue. Hidden until we have a clientSecret. */}
        <div id="payment-wrap" hidden>
          <div id="payment-element"></div>
          <p id="payment-error" class="payment-error" role="alert" hidden></p>
        </div>

        <button type="button" class="btn btn-primary book-btn" id="book-btn" disabled={!tiersHaveIds || !stripePublishableKey}>
          Continue to payment &rarr;
        </button>
        <button type="button" class="btn btn-primary book-btn" id="pay-btn" hidden>
          Pay now &rarr;
        </button>

        {!tiersHaveIds && (
          <p class="fine warn">
            Bookings are temporarily unavailable while we reconnect to the game service. Please try again shortly.
          </p>
        )}
        {tiersHaveIds && !stripePublishableKey && (
          <p class="fine warn">
            Payment configuration missing. Please contact support if this persists.
          </p>
        )}

        <p class="fine">
          By booking you agree to our <a href="/terms">Terms</a> and
          confirm you&rsquo;ve read <a href="/before-you-play">Before you play</a>.
          See our <a href="/refunds">refund policy</a>.
        </p>
      </section>
    ) : (
      <section class="booking wrap-narrow" id="book">
        <div class="eyebrow">Waitlist</div>
        <h2>Get notified when bookings open.</h2>

        {openDateFormatted && (
          <p class="waitlist-note">
            Bookings for {displayTitle} open <strong>{openDateFormatted}</strong>.
            Drop your email and we&rsquo;ll message you the moment they do.
          </p>
        )}

        <label class="field">
          <span>Your email</span>
          <input type="email" id="waitlist-email" placeholder="you@example.com" />
        </label>

        <button type="button" class="btn btn-primary book-btn" id="waitlist-btn">
          Notify me &rarr;
        </button>

        <div class="waitlist-success" id="waitlist-success" hidden>
          You&rsquo;re on the list. Watch your inbox.
        </div>

        <p class="fine">
          One-off email, only for launch notification.
          See our <a href="/privacy">privacy policy</a>.
        </p>
      </section>
    )}

    <!-- ==========  Embedded leaderboard (top 10)  ========== -->
    <section class="lb-inline wrap-narrow" id="leaderboard">
      <div class="eyebrow"><span class="dot"></span>Leaderboard</div>
      <h2>Fastest teams</h2>
      <p class="lb-note">Top ten completions of {displayTitle}, sorted by fastest time.</p>

      <div id="lb-inline-loading" class="lb-state">Loading&hellip;</div>
      <table id="lb-inline-table" class="lb-table" hidden>
        <thead>
          <tr>
            <th class="rank">#</th>
            <th>Team</th>
            <th class="right">Players</th>
            <th class="right">Time</th>
          </tr>
        </thead>
        <tbody id="lb-inline-body"></tbody>
      </table>
      <p id="lb-inline-empty" class="lb-state" hidden>No scores yet. Be the first.</p>
      <p id="lb-inline-error" class="lb-state" hidden>Could not load leaderboard.</p>

      <a href={`/games/${game.slug}/leaderboard`} class="btn btn-ghost lb-view-full">
        View full leaderboard &rarr;
      </a>
    </section>
  </article>

  <script define:vars={{ waitlistUrl, appGameId, appBaseUrl, stripePublishableKey }}>
    // ---------------------------------------------------------------
    // Booking / payment flow
    //
    // Two-step:
    //   1. Continue: validate form, POST to /api/create-guest-checkout
    //      (our server proxies to the game app's guest-checkout endpoint),
    //      get back a Stripe PaymentIntent client secret, mount Stripe
    //      Elements with it.
    //   2. Pay now: confirm the payment with Stripe.js. On success Stripe
    //      redirects to /checkout/success. Behind the scenes, the game
    //      app's Stripe webhook picks up the successful payment and emails
    //      the buyer a magic sign-in link to open the game in the app.
    // ---------------------------------------------------------------
    const continueBtn = document.getElementById('book-btn');
    const payBtn      = document.getElementById('pay-btn');
    const paymentWrap = document.getElementById('payment-wrap');
    const paymentEl   = document.getElementById('payment-element');
    const errorEl     = document.getElementById('payment-error');

    let stripe = null;
    let elements = null;

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function clearError() {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.hidden = true;
    }

    // Lazy-load Stripe.js only when needed, so pages without a checkout
    // don't pay the JS cost.
    async function loadStripeJs() {
      if (window.Stripe) return;
      await new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://js.stripe.com/v3/';
        s.async = true;
        s.onload = resolve;
        s.onerror = () => reject(new Error('Failed to load Stripe.js'));
        document.head.appendChild(s);
      });
    }

    if (continueBtn) {
      continueBtn.addEventListener('click', async () => {
        clearError();
        const gameId      = document.querySelector('.tiers')?.dataset.gameId;
        const tierId      = document.querySelector('input[name="tier"]:checked')?.value;
        const teamName    = document.getElementById('teamName').value.trim();
        const displayName = document.getElementById('displayName').value.trim();
        const email       = document.getElementById('email').value.trim();

        if (!gameId)     { showError('Bookings are temporarily unavailable, please try again shortly.'); return; }
        if (!tierId)     { showError('Pick a team size.'); return; }
        if (!teamName)   { showError('Enter a team name.'); return; }
        if (!displayName){ showError('Enter your name.'); return; }
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError('Enter a valid email.');
          return;
        }
        if (!stripePublishableKey) {
          showError('Payment is not configured. Please contact support.');
          return;
        }

        continueBtn.setAttribute('disabled', 'true');
        continueBtn.innerText = 'Setting up payment…';

        try {
          // 1. Ask our server to provision the session + PaymentIntent.
          const res = await fetch('/api/create-guest-checkout', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ gameId, tierId, teamName, displayName, email }),
          });
          const data = await res.json().catch(() => ({}));

          if (!res.ok) {
            // 422 with NICKNAME_NOT_ALLOWED → surface it plainly
            if (data?.error === 'NICKNAME_NOT_ALLOWED') {
              const left = typeof data.warningsRemaining === 'number'
                ? ` (${data.warningsRemaining} warning${data.warningsRemaining === 1 ? '' : 's'} remaining)`
                : '';
              showError(`That team name isn't allowed${left}. Try another.`);
            } else {
              showError(data?.error || data?.message || 'Could not start checkout. Try again.');
            }
            continueBtn.removeAttribute('disabled');
            continueBtn.innerText = 'Continue to payment →';
            return;
          }

          // Stub payment path (dev/test only) — session is already marked
          // paid on the app side and no Stripe UI is needed. Send them
          // straight to the success page.
          if (data.stub) {
            window.location.href = '/checkout/success?stub=1';
            return;
          }

          // 2. Mount Stripe Elements with the returned client secret.
          await loadStripeJs();
          stripe = window.Stripe(stripePublishableKey);
          elements = stripe.elements({
            clientSecret: data.clientSecret,
            appearance: { theme: 'night' }, // matches the dark UI
          });
          const paymentElement = elements.create('payment');
          paymentElement.mount('#payment-element');

          // Swap Continue → Pay button
          continueBtn.hidden = true;
          paymentWrap.hidden = false;
          payBtn.hidden = false;
        } catch (err) {
          console.error(err);
          showError('Could not start checkout. Try again in a moment.');
          continueBtn.removeAttribute('disabled');
          continueBtn.innerText = 'Continue to payment →';
        }
      });
    }

    if (payBtn) {
      payBtn.addEventListener('click', async () => {
        clearError();
        if (!stripe || !elements) { showError('Payment not ready.'); return; }

        payBtn.setAttribute('disabled', 'true');
        payBtn.innerText = 'Processing…';

        const { error } = await stripe.confirmPayment({
          elements,
          confirmParams: {
            return_url: `${window.location.origin}/checkout/success`,
          },
        });

        // If confirmPayment resolves without redirecting, the payment
        // failed synchronously (bad card, declined, etc.) — show the
        // message and let the user try again.
        if (error) {
          showError(error.message || 'Payment failed. Please try again.');
          payBtn.removeAttribute('disabled');
          payBtn.innerText = 'Pay now →';
        }
      });
    }

    // --- Waitlist button ---
    const waitlistBtn = document.getElementById('waitlist-btn');
    if (waitlistBtn) {
      waitlistBtn.addEventListener('click', async () => {
        const emailEl   = document.getElementById('waitlist-email');
        const successEl = document.getElementById('waitlist-success');
        const email     = emailEl.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          alert('Enter a valid email.');
          return;
        }
        if (!waitlistUrl) {
          alert('Waitlist not configured yet. Please check back soon.');
          return;
        }

        waitlistBtn.setAttribute('disabled', 'true');
        waitlistBtn.innerText = 'Adding…';

        try {
          const data = new FormData();
          data.append('EMAIL', email);
          data.append('email_address_check', '');
          data.append('locale', 'en');
          data.append('html_type', 'simple');
          await fetch(waitlistUrl, {
            method: 'POST',
            mode: 'no-cors',
            body: data,
          });
          emailEl.style.display = 'none';
          waitlistBtn.style.display = 'none';
          successEl.hidden = false;
        } catch (err) {
          console.error(err);
          alert('Something went wrong. Try again.');
          waitlistBtn.removeAttribute('disabled');
          waitlistBtn.innerText = 'Notify me →';
        }
      });
    }

    // --- Embedded leaderboard (top 10) ---
    async function loadInlineLeaderboard() {
      const loading = document.getElementById('lb-inline-loading');
      const table   = document.getElementById('lb-inline-table');
      const body    = document.getElementById('lb-inline-body');
      const empty   = document.getElementById('lb-inline-empty');
      const errorEl = document.getElementById('lb-inline-error');

      loading.hidden = false;
      table.hidden = true;
      empty.hidden = true;
      errorEl.hidden = true;

      if (!appGameId || !appBaseUrl) {
        loading.hidden = true;
        errorEl.hidden = false;
        return;
      }

      try {
        const res = await fetch(
          `${appBaseUrl}/api/leaderboard/${encodeURIComponent(appGameId)}?size=10`,
          { headers: { accept: 'application/json' } }
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const rows = Array.isArray(data?.content) ? data.content : [];
        loading.hidden = true;
        if (rows.length === 0) { empty.hidden = false; return; }

        body.innerHTML = rows.map((row) => {
          const t = Number(row.scoreTimeSeconds) || 0;
          const h = Math.floor(t / 3600);
          const m = Math.floor((t % 3600) / 60).toString().padStart(2, '0');
          const s = (t % 60).toString().padStart(2, '0');
          const time = h > 0 ? `${h}:${m}:${s}` : `${m}:${s}`;
          const players = row.memberCount ?? '—';
          return `
            <tr>
              <td class="rank">${row.rank ?? ''}</td>
              <td>${escapeHtml(row.teamName ?? '')}</td>
              <td class="right mono">${players}</td>
              <td class="right mono">${time}</td>
            </tr>
          `;
        }).join('');
        table.hidden = false;
      } catch (err) {
        console.error('Leaderboard fetch failed:', err);
        loading.hidden = true;
        errorEl.hidden = false;
      }
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
      }[c]));
    }
    loadInlineLeaderboard();
  </script>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    height: 70vh;
    min-height: 480px;
    overflow: hidden;
  }
  .hero picture, .hero picture img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(180deg, rgba(5,5,5,0.55), rgba(5,5,5,0.35) 30%, rgba(5,5,5,0.95));
    padding-bottom: 40px;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 8vw, 5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-top: 18px;
  }
  .tagline {
    max-width: 620px;
    margin-top: 20px;
    color: var(--ink);
    font-size: 18px;
    line-height: 1.5;
  }
  .hero-cta {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Top bar: absolutely positioned strip; the inner .wrap aligns logo (left)
     and nav (right) with the same max-width centered box as the heading. */
  .hero-topbar {
    position: absolute;
    top: 32px;
    left: 0;
    right: 0;
    z-index: 3;
  }
  .hero-topbar-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .hero-logo {
    display: block;
    filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.6));
    transition: transform 0.25s ease;
  }
  .hero-logo:hover { transform: translateY(-2px); }
  .hero-logo img {
    display: block;
    height: 88px;
    width: auto;
  }

  .hero-nav {
    margin-top: 12px; /* optical-align with the logo baseline */
    display: flex;
    gap: 22px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero-nav a {
    color: rgba(245, 245, 245, 0.75);
    text-decoration: none;
    transition: color 0.15s;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .hero-nav a:hover { color: var(--ink); }

  @media (max-width: 620px) {
    .hero-nav { display: none; } /* mobile uses the hamburger overlay */
    .hero-topbar { top: 24px; }
    .hero-logo img { height: 68px; }
  }

  /* ---------- META ---------- */
  .meta { padding: 40px 0; border-bottom: 1px solid var(--line); }
  .meta dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ink-dim);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .meta dd { font-size: 16px; }

  /* ---------- BODY / EXPECT ---------- */
  .body { padding-block: 60px 20px; }
  .body .eyebrow {
    display: block;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .briefing {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
    white-space: pre-line;
  }

  .expect { padding-block: 40px 20px; }
  .expect .eyebrow {
    display: block;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .expect ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .expect li {
    position: relative;
    padding-left: 22px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink);
  }
  .expect li::before {
    content: '▸';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-size: 14px;
  }

  /* ---------- EMBEDDED LEADERBOARD ---------- */
  .lb-inline { padding-block: 40px 20px; }
  .lb-inline .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    width: 100%;
  }
  .lb-inline h2 {
    font-size: 24px;
    margin-bottom: 6px;
  }
  .lb-note {
    color: var(--ink-dim);
    font-size: 14px;
