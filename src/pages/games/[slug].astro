---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { formatPricePence, fetchGamesCatalogue, slugify } from '@/lib/pricing';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => data.status === 'live');
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const city = await getEntry('cities', game.data.citySlug);

// Overlay live app data on top of Markdown-owned fields.
const catalogue = await fetchGamesCatalogue();
const apiGame = catalogue.find(
  (g) => g.slug === game.slug || slugify(g.name) === game.slug
);

const displayTitle       = apiGame?.name ?? game.data.title;
const displayDescription = apiGame?.description ?? game.data.summary;
const whatToExpect       = apiGame?.whatToExpectPoints ?? [];
const displayCity        = apiGame?.location ?? city?.data.name ?? game.data.citySlug;

// Booking window
const now = new Date();
const bookingsOpen = !game.data.bookingsOpenAt
  || now >= new Date(game.data.bookingsOpenAt);
const openDateFormatted = game.data.bookingsOpenAt
  ? new Date(game.data.bookingsOpenAt).toLocaleDateString('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
    })
  : null;
const waitlistUrl = import.meta.env.PUBLIC_BREVO_WAITLIST_URL ?? '';

// Leaderboard: pass the app's UUID for this game to the client script.
const appGameId = apiGame?.id ?? null;
const appBaseUrl = import.meta.env.APP_BACKEND_URL ?? '';
---

<BaseLayout
  title={`${displayTitle}, Unknown Sender`}
  description={game.data.tagline}
  canonicalPath={`/games/${game.slug}`}
  ogImage={game.data.heroImageDesktop}
  bodyClass="hero-page"
>
  <article>
    <section class="hero">
      <picture>
        <source media="(min-width: 768px)" srcset={game.data.heroImageDesktop} />
        <img src={game.data.heroImageMobile} alt={game.data.heroImageAlt} />
      </picture>

      <!-- Brand mark + nav pinned inside the hero (same pattern as home) -->
      <a href="/" class="hero-logo" aria-label="Unknown Sender home">
        <img
          src="/logo-640.png"
          srcset="/logo-640.png 1x, /logo-trimmed.png 2x"
          alt="Unknown Sender"
          width="220"
          height="107"
        />
      </a>
      <nav class="hero-nav" aria-label="Primary">
        <a href="/games">Case files</a>
        <a href="/before-you-play">Before you play</a>
      </nav>

      <div class="hero-overlay">
        <div class="wrap">
          <div class="eyebrow"><span class="dot"></span>{displayCity}</div>
          <h1>{displayTitle}</h1>
          <p class="tagline">{game.data.tagline}</p>
          <div class="hero-cta">
            <a href="#book" class="btn btn-primary">
              {bookingsOpen ? `Book ${displayTitle}` : 'Join waitlist'} &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="meta">
      <div class="wrap">
        <dl>
          <div><dt>Duration</dt><dd>{game.data.duration}</dd></div>
          <div><dt>Team size</dt><dd>Up to {Math.max(...game.data.priceTiers.map((t) => t.maxPlayers))}</dd></div>
          <div><dt>Age</dt><dd>{game.data.ageMin}+</dd></div>
          <div><dt>Valid for</dt><dd>{game.data.validityDays} days from purchase</dd></div>
        </dl>
      </div>
    </section>

    <section class="body wrap-narrow">
      <div class="eyebrow">Mission briefing</div>
      <p class="briefing">{displayDescription}</p>
    </section>

    {whatToExpect.length > 0 && (
      <section class="expect wrap-narrow">
        <div class="eyebrow">What to expect</div>
        <ul>
          {whatToExpect.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    )}

    {bookingsOpen ? (
      <section class="booking wrap-narrow" id="book">
        <div class="eyebrow">Book</div>
        <h2>Choose your team size</h2>

        <div class="tiers" data-game-slug={game.slug}>
          {game.data.priceTiers.map((tier) => (
            <label class="tier">
              <input type="radio" name="tier" value={tier.id} data-price-pence={tier.pricePence} />
              <div class="tier-label">
                <div>
                  <div class="tier-name">{tier.label}</div>
                  <div class="tier-note">Up to {tier.maxPlayers} players</div>
                </div>
                <div class="tier-price">{formatPricePence(tier.pricePence)}</div>
              </div>
            </label>
          ))}
        </div>

        <label class="field">
          <span>Team name</span>
          <input type="text" name="teamName" id="teamName" maxlength="50" placeholder="e.g. The Suspects" />
        </label>

        <label class="field">
          <span>Your email</span>
          <input type="email" name="email" id="email" placeholder="you@example.com" />
        </label>

        <button type="button" class="btn btn-primary book-btn" id="book-btn">
          Book &rarr;
        </button>

        <p class="fine">
          By booking you agree to our <a href="/terms">Terms</a> and
          confirm you&rsquo;ve read <a href="/before-you-play">Before you play</a>.
          See our <a href="/refunds">refund policy</a>.
        </p>
      </section>
    ) : (
      <section class="booking wrap-narrow" id="book">
        <div class="eyebrow">Waitlist</div>
        <h2>Get notified when bookings open.</h2>

        {openDateFormatted && (
          <p class="waitlist-note">
            Bookings for {displayTitle} open <strong>{openDateFormatted}</strong>.
            Drop your email and we&rsquo;ll message you the moment they do.
          </p>
        )}

        <label class="field">
          <span>Your email</span>
          <input type="email" id="waitlist-email" placeholder="you@example.com" />
        </label>

        <button type="button" class="btn btn-primary book-btn" id="waitlist-btn">
          Notify me &rarr;
        </button>

        <div class="waitlist-success" id="waitlist-success" hidden>
          You&rsquo;re on the list. Watch your inbox.
        </div>

        <p class="fine">
          One-off email, only for launch notification.
          See our <a href="/privacy">privacy policy</a>.
        </p>
      </section>
    )}

    <!-- ==========  Embedded leaderboard (top 10)  ========== -->
    <section class="lb-inline wrap-narrow" id="leaderboard">
      <div class="eyebrow"><span class="dot"></span>Leaderboard</div>
      <h2>Fastest teams</h2>
      <p class="lb-note">Top ten completions of {displayTitle}, sorted by fastest time.</p>

      <div id="lb-inline-loading" class="lb-state">Loading&hellip;</div>
      <table id="lb-inline-table" class="lb-table" hidden>
        <thead>
          <tr>
            <th class="rank">#</th>
            <th>Team</th>
            <th class="right">Players</th>
            <th class="right">Time</th>
          </tr>
        </thead>
        <tbody id="lb-inline-body"></tbody>
      </table>
      <p id="lb-inline-empty" class="lb-state" hidden>No scores yet. Be the first.</p>
      <p id="lb-inline-error" class="lb-state" hidden>Could not load leaderboard.</p>

      <a href={`/games/${game.slug}/leaderboard`} class="btn btn-ghost lb-view-full">
        View full leaderboard &rarr;
      </a>
    </section>
  </article>

  <script define:vars={{ waitlistUrl, appGameId, appBaseUrl }}>
    // --- Booking button ---
    const btn = document.getElementById('book-btn');
    if (btn) {
      btn.addEventListener('click', async () => {
        const gameSlug = document.querySelector('.tiers')?.dataset.gameSlug;
        const tier = document.querySelector('input[name="tier"]:checked')?.value;
        const teamName = document.getElementById('teamName').value.trim();
        const email = document.getElementById('email').value.trim();

        if (!tier)     { alert('Pick a team size.'); return; }
        if (!teamName) { alert('Enter a team name.'); return; }
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          alert('Enter a valid email.');
          return;
        }

        btn.setAttribute('disabled', 'true');
        btn.innerText = 'Redirecting…';

        try {
          const res = await fetch('/api/create-checkout-session', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ gameSlug, tierId: tier, teamName, email }),
          });
          const data = await res.json();
          if (!res.ok || !data.url) throw new Error(data.error ?? 'Checkout failed');
          window.location.href = data.url;
        } catch (err) {
          console.error(err);
          alert('Could not start checkout. Try again in a moment.');
          btn.removeAttribute('disabled');
          btn.innerText = 'Book →';
        }
      });
    }

    // --- Waitlist button ---
    const waitlistBtn = document.getElementById('waitlist-btn');
    if (waitlistBtn) {
      waitlistBtn.addEventListener('click', async () => {
        const emailEl   = document.getElementById('waitlist-email');
        const successEl = document.getElementById('waitlist-success');
        const email     = emailEl.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          alert('Enter a valid email.');
          return;
        }
        if (!waitlistUrl) {
          alert('Waitlist not configured yet. Please check back soon.');
          return;
        }

        waitlistBtn.setAttribute('disabled', 'true');
        waitlistBtn.innerText = 'Adding…';

        try {
          const data = new FormData();
          data.append('EMAIL', email);
          data.append('email_address_check', '');
          data.append('locale', 'en');
          data.append('html_type', 'simple');
          await fetch(waitlistUrl, {
            method: 'POST',
            mode: 'no-cors',
            body: data,
          });
          emailEl.style.display = 'none';
          waitlistBtn.style.display = 'none';
          successEl.hidden = false;
        } catch (err) {
          console.error(err);
          alert('Something went wrong. Try again.');
          waitlistBtn.removeAttribute('disabled');
          waitlistBtn.innerText = 'Notify me →';
        }
      });
    }

    // --- Embedded leaderboard (top 10) ---
    async function loadInlineLeaderboard() {
      const loading = document.getElementById('lb-inline-loading');
      const table   = document.getElementById('lb-inline-table');
      const body    = document.getElementById('lb-inline-body');
      const empty   = document.getElementById('lb-inline-empty');
      const errorEl = document.getElementById('lb-inline-error');

      loading.hidden = false;
      table.hidden = true;
      empty.hidden = true;
      errorEl.hidden = true;

      if (!appGameId || !appBaseUrl) {
        loading.hidden = true;
        errorEl.hidden = false;
        return;
      }

      try {
        const res = await fetch(
          `${appBaseUrl}/api/leaderboard/${encodeURIComponent(appGameId)}?size=10`,
          { headers: { accept: 'application/json' } }
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const rows = Array.isArray(data?.content) ? data.content : [];
        loading.hidden = true;
        if (rows.length === 0) { empty.hidden = false; return; }

        body.innerHTML = rows.map((row) => {
          const t = Number(row.scoreTimeSeconds) || 0;
          const h = Math.floor(t / 3600);
          const m = Math.floor((t % 3600) / 60).toString().padStart(2, '0');
          const s = (t % 60).toString().padStart(2, '0');
          const time = h > 0 ? `${h}:${m}:${s}` : `${m}:${s}`;
          const players = row.memberCount ?? '—';
          return `
            <tr>
              <td class="rank">${row.rank ?? ''}</td>
              <td>${escapeHtml(row.teamName ?? '')}</td>
              <td class="right mono">${players}</td>
              <td class="right mono">${time}</td>
            </tr>
          `;
        }).join('');
        table.hidden = false;
      } catch (err) {
        console.error('Leaderboard fetch failed:', err);
        loading.hidden = true;
        errorEl.hidden = false;
      }
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
      }[c]));
    }
    loadInlineLeaderboard();
  </script>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    height: 70vh;
    min-height: 480px;
    overflow: hidden;
  }
  .hero picture, .hero picture img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(180deg, rgba(5,5,5,0.55), rgba(5,5,5,0.35) 30%, rgba(5,5,5,0.95));
    padding-bottom: 40px;
  }
  .hero h1 {
    font-size: clamp(2.8rem, 8vw, 5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-top: 18px;
  }
  .tagline {
    max-width: 620px;
    margin-top: 20px;
    color: var(--ink);
    font-size: 18px;
    line-height: 1.5;
  }
  .hero-cta {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Brand mark pinned inside the hero (matches home page pattern) */
  .hero-logo {
    position: absolute;
    top: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: block;
    filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.6));
    transition: transform 0.25s ease;
  }
  .hero-logo:hover { transform: translateX(-50%) translateY(-2px); }
  .hero-logo img {
    display: block;
    height: 88px;
    width: auto;
  }

  .hero-nav {
    position: absolute;
    top: 48px;
    right: 40px;
    z-index: 3;
    display: flex;
    gap: 22px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero-nav a {
    color: rgba(245, 245, 245, 0.75);
    text-decoration: none;
    transition: color 0.15s;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .hero-nav a:hover { color: var(--ink); }

  @media (max-width: 620px) {
    .hero-nav { display: none; } /* mobile uses the hamburger overlay */
    .hero-logo img { height: 68px; }
    .hero-logo { top: 24px; }
  }

  /* ---------- META ---------- */
  .meta { padding: 40px 0; border-bottom: 1px solid var(--line); }
  .meta dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--ink-dim);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .meta dd { font-size: 16px; }

  /* ---------- BODY / EXPECT ---------- */
  .body { padding-block: 60px 20px; }
  .body .eyebrow {
    display: block;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .briefing {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
    white-space: pre-line;
  }

  .expect { padding-block: 40px 20px; }
  .expect .eyebrow {
    display: block;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .expect ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .expect li {
    position: relative;
    padding-left: 22px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink);
  }
  .expect li::before {
    content: '▸';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--accent);
    font-size: 14px;
  }

  /* ---------- EMBEDDED LEADERBOARD ---------- */
  .lb-inline { padding-block: 40px 20px; }
  .lb-inline .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    width: 100%;
  }
  .lb-inline h2 {
    font-size: 24px;
    margin-bottom: 6px;
  }
  .lb-note {
    color: var(--ink-dim);
    font-size: 14px;
    margin-bottom: 24px;
  }
  .lb-state {
    padding: 24px;
    text-align: center;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    border: 1px solid var(--line);
    border-radius: 10px;
    margin-bottom: 20px;
  }
  .lb-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    margin-bottom: 20px;
  }
  .lb-table th {
    text-align: left;
    padding: 10px 10px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line);
  }
  .lb-table td {
    padding: 12px 10px;
    border-bottom: 1px solid var(--line);
  }
  .lb-table .rank {
    width: 34px;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .lb-table tbody tr:first-child .rank { color: var(--accent); }
  .lb-table .right { text-align: right; }
  .lb-table .mono {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-dim);
  }
  .lb-view-full {
    display: inline-flex;
    padding: 12px 20px;
    font-size: 12px;
  }

  /* ---------- BOOKING / WAITLIST ---------- */
  .booking { padding-block: 40px 40px; }
  .lb-inline { padding-block: 24px 48px; }
  .booking h2 { font-size: 28px; margin: 16px 0 24px; }

  .tiers { display: grid; gap: 12px; margin-bottom: 32px; }
  .tier { display: block; cursor: pointer; }
  .tier input { position: absolute; opacity: 0; pointer-events: none; }
  .tier-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    transition: border-color 0.2s, background 0.2s;
  }
  .tier input:checked + .tier-label {
    border-color: var(--accent);
    background: rgba(225,20,20,0.06);
  }
  .tier-name { font-size: 16px; font-weight: 600; }
  .tier-note {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--ink-dim);
    text-transform: uppercase;
    margin-top: 4px;
  }
  .tier-price { font-size: 22px; font-weight: 600; }

  .field { display: block; margin-bottom: 18px; }
  .field span {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 8px;
  }
  .field input {
    width: 100%;
    padding: 14px 18px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
  }
  .field input:focus { outline: none; border-color: var(--accent); }

  .book-btn { width: 100%; margin-top: 12px; padding: 18px; font-size: 14px; }

  .fine {
    margin-top: 16px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ink-dim);
    text-align: center;
  }
  .fine a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  .waitlist-note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-dim);
    margin-bottom: 28px;
    max-width: 520px;
  }
  .waitlist-note strong { color: var(--ink); }

  .waitlist-success {
    margin-top: 20px;
    padding: 18px 22px;
    background: rgba(225, 20, 20, 0.06);
    border: 1px solid rgba(225, 20, 20, 0.28);
    border-radius: 12px;
    color: var(--ink);
    font-size: 15px;
    text-align: center;
  }
</style>
