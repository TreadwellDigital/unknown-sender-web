---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { fetchGamesCatalogue, slugify } from '@/lib/pricing';

export async function getStaticPaths() {
  const games = await getCollection('games', ({ data }) => data.status === 'live');
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;

// Look up the app's UUID for this game at build time so the client
// script can fetch the leaderboard directly, without a first round-trip
// to /api/games. Falls back to null if the app is unreachable at build.
const catalogue = await fetchGamesCatalogue();
const apiGame = catalogue.find(
  (g) => g.slug === game.slug || slugify(g.name) === game.slug
);
const appGameId = apiGame?.id ?? null;
const appBaseUrl = import.meta.env.APP_BACKEND_URL ?? '';
---

<BaseLayout
  title={`${game.data.title} — Leaderboard`}
  description={`Public leaderboard for ${game.data.title}.`}
  canonicalPath={`/games/${game.slug}/leaderboard`}
>
  <section class="page">
    <div class="wrap-narrow">
      <div class="eyebrow"><span class="dot"></span>Leaderboard</div>
      <h1>{game.data.title}</h1>
      <p class="sub">Top teams, sorted by fastest completion time.</p>

      <div id="lb-loading" class="loading">Loading&hellip;</div>
      <table id="lb-table" class="lb" hidden>
        <thead>
          <tr>
            <th class="rank">#</th>
            <th>Team</th>
            <th class="right">Players</th>
            <th class="right">Time</th>
          </tr>
        </thead>
        <tbody id="lb-body"></tbody>
      </table>
      <p id="lb-empty" class="empty" hidden>
        No scores yet. Be the first.
      </p>
      <p id="lb-error" class="empty" hidden>
        Could not load leaderboard.
      </p>

      <div class="actions">
        <a class="btn btn-primary" href={`/games/${game.slug}`}>Play {game.data.title}</a>
        <button type="button" class="btn btn-ghost" id="lb-reload">Refresh</button>
      </div>
    </div>
  </section>

  <script define:vars={{ appGameId, appBaseUrl }}>
    async function loadLeaderboard() {
      const loading = document.getElementById('lb-loading');
      const table   = document.getElementById('lb-table');
      const body    = document.getElementById('lb-body');
      const empty   = document.getElementById('lb-empty');
      const errorEl = document.getElementById('lb-error');

      loading.hidden = false;
      table.hidden   = true;
      empty.hidden   = true;
      errorEl.hidden = true;

      // Guard: if the app wasn't reachable at build time, we don't
      // have a gameId, so we can't fetch the leaderboard.
      if (!appGameId || !appBaseUrl) {
        loading.hidden = true;
        errorEl.hidden = false;
        errorEl.textContent = 'Leaderboard unavailable right now.';
        return;
      }

      try {
        const res = await fetch(
          `${appBaseUrl}/api/leaderboard/${encodeURIComponent(appGameId)}?size=25`,
          { headers: { accept: 'application/json' } }
        );
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const rows = Array.isArray(data?.content) ? data.content : [];

        loading.hidden = true;

        if (rows.length === 0) {
          empty.hidden = false;
          return;
        }

        body.innerHTML = rows.map((row) => {
          const t = Number(row.scoreTimeSeconds) || 0;
          const h = Math.floor(t / 3600);
          const m = Math.floor((t % 3600) / 60).toString().padStart(2, '0');
          const s = (t % 60).toString().padStart(2, '0');
          const time = h > 0 ? `${h}:${m}:${s}` : `${m}:${s}`;
          const players = row.memberCount ?? '—';
          return `
            <tr>
              <td class="rank">${row.rank ?? ''}</td>
              <td>${escapeHtml(row.teamName ?? '')}</td>
              <td class="right mono">${players}</td>
              <td class="right mono">${time}</td>
            </tr>
          `;
        }).join('');
        table.hidden = false;
      } catch (err) {
        console.error('Leaderboard fetch failed:', err);
        loading.hidden = true;
        errorEl.hidden = false;
      }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
      }[c]));
    }

    loadLeaderboard();
    document.getElementById('lb-reload')?.addEventListener('click', loadLeaderboard);
  </script>
</BaseLayout>

<style>
  .page { padding: 80px 0; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 16px 0 8px; }
  .sub { color: var(--ink-dim); margin-bottom: 40px; font-size: 15px; }

  .loading, .empty {
    padding: 40px;
    text-align: center;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .lb {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .lb th {
    text-align: left;
    padding: 12px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line);
  }
  .lb td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--line);
  }
  .lb .rank {
    width: 40px;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .lb .right { text-align: right; }
  .lb .mono { font-family: var(--font-mono); font-size: 13px; color: var(--ink-dim); }
  .lb tbody tr:first-child .rank { color: var(--accent); }

  .actions {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
