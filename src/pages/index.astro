---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { formatPricePence } from '@/lib/pricing';

// All games — the map below renders live ones as bookable cards and
// coming-soon ones as dimmed teasers. Sorted by `order` so Last Call
// always leads.
const games = (await getCollection('games'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Unknown Sender — A city. A case. A sender you can't trust."
  description="A real-world, story-led mystery played on foot across the streets of Leeds."
  canonicalPath="/"
  bodyClass="home hero-page"
>
  <section class="hero">
    <!-- Background image (was a <video>; static image for now) -->
    <div class="hero-image" aria-hidden="true"></div>
    <!-- Vignette + darkening overlay so text stays legible -->
    <div class="hero-shade" aria-hidden="true"></div>

    <!-- Brand mark, in normal flow at top of the flex column -->
    <a href="/" class="hero-logo" aria-label="Unknown Sender home">
      <img
        src="/logo-640.png"
        srcset="/logo-640.png 1x, /logo-trimmed.png 2x"
        alt="Unknown Sender"
        width="220"
        height="107"
      />
    </a>

    <!-- Desktop nav, top-right (hamburger handles mobile via MobileNav component) -->
    <nav class="hero-nav" aria-label="Primary">
      <a href="/games">Case files</a>
      <a href="/before-you-play">Before you play</a>
    </nav>

    <!-- Copy + CTAs pushed to bottom via margin-top: auto -->
    <div class="wrap hero-content">
      <div class="eyebrow"><span class="dot"></span>Leeds &nbsp;/&nbsp; Live now</div>
      <h1>A city.<br/>A case.<br/>A sender you can&rsquo;t trust.</h1>
      <p class="lede">
        A mystery delivered to your phone and played on foot across Leeds.
        Follow messages and clues through real locations before the night
        runs out.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/games/last-call">Book Last Call</a>
        <a class="btn btn-ghost" href="/games">View all case files</a>
      </div>
    </div>

    <a class="scroll-hint" href="#explore" aria-label="Scroll to explore games">
      <span>Explore the game</span>
      <span class="arrow-down" aria-hidden="true">&darr;</span>
    </a>
  </section>

  <!-- =====================  EXPLORE  ===================== -->
  <section id="explore" class="explore">
    <div class="wrap">
      <div class="explore-head">
        <div class="eyebrow">Case files</div>
        <h2>Four cases. One city.</h2>
        <p class="explore-sub">Last Call is only the beginning.</p>
      </div>

      <div class="explore-grid">
        {games.map((g) => {
          const isLive = g.data.status === 'live';
          const cheapest = isLive
            ? [...g.data.priceTiers].sort((a, b) => a.pricePence - b.pricePence)[0]
            : null;

          if (isLive) {
            return (
              <a class="feature" href={`/games/${g.slug}`}>
                <div class="feature-media">
                  <picture>
                    <source media="(min-width: 768px)" srcset={g.data.heroImageDesktop} />
                    <img src={g.data.heroImageMobile} alt={g.data.heroImageAlt} loading="lazy" />
                  </picture>
                  <div class="feature-shade"></div>
                </div>
                <div class="feature-body">
                  <div class="feature-eye">
                    <span class="live-dot"></span>{g.data.citySlug} &nbsp;/&nbsp; Live now
                  </div>
                  <h3>{g.data.title}</h3>
                  <p class="feature-tag">{g.data.tagline}</p>
                  <div class="feature-meta">
                    <span class="feature-price">From {formatPricePence(cheapest!.pricePence)}</span>
                    <span class="feature-cta">Explore &rarr;</span>
                  </div>
                </div>
              </a>
            );
          }

          return (
            <div class="feature coming">
              {g.data.heroImageDesktop ? (
                <div class="feature-media">
                  <picture>
                    <source media="(min-width: 768px)" srcset={g.data.heroImageDesktop} />
                    <img src={g.data.heroImageMobile ?? g.data.heroImageDesktop} alt={g.data.heroImageAlt ?? g.data.title} loading="lazy" />
                  </picture>
                  <div class="feature-shade"></div>
                </div>
              ) : (
                <div class="feature-media placeholder" aria-hidden="true">
                  <div class="feature-shade"></div>
                </div>
              )}
              <div class="feature-body">
                <div class="feature-eye muted">
                  {g.data.citySlug} &nbsp;/&nbsp; Coming soon
                </div>
                <h3>{g.data.title}</h3>
                <p class="feature-tag">{g.data.tagline}</p>
                <div class="feature-meta">
                  <span class="feature-price">Soon</span>
                  <span class="feature-cta">&mdash;</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: 100dvh;
    min-height: 100vh; /* fallback for older browsers */
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/images/hero-poster.jpg');
    background-size: cover;
    background-position: center;
    background-color: #0a0a0a;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 50% 40%, transparent 20%, rgba(0,0,0,0.65) 90%),
      linear-gradient(180deg, rgba(5,5,5,0.35) 0%, rgba(5,5,5,0.55) 50%, rgba(5,5,5,0.92) 100%);
    pointer-events: none;
  }

  /* Logo: in flex flow, at the top, centred horizontally */
  .hero-logo {
    position: relative;
    z-index: 3;
    align-self: center;
    margin-top: 40px;
    padding: 0 20px;
    display: block;
    filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.6));
    transition: transform 0.25s ease;
  }
  .hero-logo:hover { transform: translateY(-2px); }
  .hero-logo img {
    display: block;
    height: 108px;
    width: auto;
  }

  /* Desktop nav, top-right corner */
  .hero-nav {
    position: absolute;
    top: 48px;
    right: 40px;
    z-index: 3;
    display: flex;
    gap: 22px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero-nav a {
    color: rgba(245, 245, 245, 0.75);
    text-decoration: none;
    transition: color 0.15s;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .hero-nav a:hover { color: var(--ink); }

  /* Content pushed to bottom by margin-top: auto in the flex column */
  .hero-content {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-bottom: 96px;
  }

  .hero h1 {
    margin-top: 24px;
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 720px;
    text-shadow: 0 2px 24px rgba(0,0,0,0.55);
  }

  .hero .lede {
    margin-top: 28px;
    max-width: 560px;
    font-size: 17px;
    color: rgba(245, 245, 245, 0.85);
    line-height: 1.6;
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }

  .cta-row {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* Scroll hint at bottom of hero */
  .scroll-hint {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
  }
  .scroll-hint:hover { color: var(--ink); }
  .scroll-hint .arrow-down {
    font-size: 18px;
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  @media (max-width: 620px) {
    .hero-nav { display: none; } /* mobile uses the hamburger overlay */
    .hero-logo { margin-top: 28px; }
    .hero-logo img { height: 76px; }
    .hero-content { padding-bottom: 80px; }
    .hero h1 { margin-top: 16px; }
    .hero .lede { margin-top: 20px; font-size: 16px; }
    .cta-row { margin-top: 28px; }
  }

  /* ---------- EXPLORE ---------- */
  .explore {
    padding: 60px 0 32px;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(225,20,20,0.06) 0%, transparent 60%),
      var(--bg);
  }
  @media (max-width: 620px) {
    .explore { padding: 40px 0 24px; }
  }

  .explore-head { margin-bottom: 44px; max-width: 640px; }
  .explore-head h2 {
    margin: 18px 0 12px;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .explore-sub {
    color: var(--ink-dim);
    font-size: 16px;
    line-height: 1.6;
  }

  .explore-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .explore-grid {
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    }
  }

  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    background: var(--panel);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  a.feature:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    color: var(--ink);
  }
  a.feature:hover .feature-cta { color: var(--accent); }
  a.feature:hover .feature-media img { transform: scale(1.03); }

  .feature.coming { cursor: default; }
  .feature.coming .feature-body { opacity: 0.75; }

  .feature-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, #111 0%, #050505 100%);
  }
  .feature-media.placeholder {
    background:
      radial-gradient(ellipse at 30% 40%, rgba(225,20,20,0.1), transparent 60%),
      radial-gradient(ellipse at 70% 70%, rgba(255,255,255,0.03), transparent 60%),
      linear-gradient(135deg, #0d0d0d 0%, #050505 100%);
  }
  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .feature-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(5,5,5,0.7) 100%);
    pointer-events: none;
  }

  .feature-body { padding: 26px 28px 28px; }

  .feature-eye {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 14px;
  }
  .feature-eye.muted { color: var(--ink-faint); }
  .feature-eye .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .feature h3 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .feature-tag {
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1.55;
    max-width: 460px;
    margin-bottom: 22px;
  }

  .feature-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .feature-price {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .feature-cta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color 0.2s;
  }
</style>
