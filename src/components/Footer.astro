          </svg>
        </a>
        <a
          href="https://www.tiktok.com/@unknownsenderuk"
          target="_blank" rel="noopener noreferrer"
          aria-label="TikTok"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </a>
        <a
          href="https://twitter.com/unknownsenderhq"
          target="_blank" rel="noopener noreferrer"
          aria-label="X (formerly Twitter)"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/profile.php?id=61592416090629"
          target="_blank" rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>
          </svg>
        </a>
      </div>
    </div>

    <nav class="links" aria-label="Footer">
      <a href="/info">Info</a>
      <a href="/player-manual">How to play</a>
      <a href="/before-you-play">Before you play</a>
      <a href="/refunds">Refunds</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="#" data-cookie-prefs>Cookies</a>
    </nav>
  </div>

  <div class="wrap credit">
    <span>&copy; {year} Unknown Sender</span>
    <span>Made in the UK</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 40px;
    padding: 32px 0 24px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .site-footer .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 40px;
    align-items: flex-start;
    justify-content: space-between;
  }

  .col { max-width: 240px; }

  .brand-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-weight: 600;
  }

  .brand-line .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
  }

  .muted {
    margin-top: 12px;
    color: var(--ink-dim);
    letter-spacing: 0.06em;
    text-transform: none;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 22px;
    max-width: 460px;
  }

  .links a {
    color: var(--ink-dim);
    text-decoration: none;
    transition: color 0.15s;
  }

  .links a:hover { color: var(--ink); }

  .socials {
    margin-top: 20px;
    display: flex;
    gap: 14px;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink-dim);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .socials a:hover {
    color: var(--ink);
    border-color: var(--line-strong);
    background: rgba(255, 255, 255, 0.04);
  }
  .socials svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .credit {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    color: var(--ink-faint);
  }

  @media (max-width: 520px) {
    .credit { flex-direction: column; gap: 8px; }
  }
</style>
