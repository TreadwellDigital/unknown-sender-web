---
/**
 * Footer — sits at the bottom of every page.
 * Legal + safety links, plus the cookies preferences trigger.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="col">
      <span class="brand-line">
        <span class="dot"></span>
        Unknown Sender
      </span>
      <p class="muted">A real-world mystery,<br/>played across UK cities.</p>

      <div class="socials" aria-label="Social media">
        <a
          href="https://www.instagram.com/Playunknownsender/"
          target="_blank" rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
